    <ui:VisualElement name="bottom-bar" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-around; align-self: auto; position: absolute; bottom: 0; width: 100%; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; align-content: center; word-spacing: 0; -unity-paragraph-spacing: 0; -unity-text-auto-size: none;">
