  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Durante a\xF1os he cargado con tres muertes que\r\nnadie puede atribuirme.
    Tres vidas que arrebat\xE9,\r\ntres secretos que me persiguen incluso\r\ncuando
    cierro los ojos.\r\n\r\nLa primera fue la de Elena. Ocurri\xF3 a las 13:30.\r\nRecuerdo
    la luz que entraba por la ventana\r\ny el silencio que qued\xF3 despu\xE9s. Ella
    confiaba en m\xED.\r\nFue precisamente esa confianza la que utilic\xE9\r\npara
    acercarme. Nunca olvidar\xE9 su rostro cuando\r\ncomprendi\xF3 que ya no hab\xEDa
    vuelta atr\xE1s.\r\n\r\nLa segunda fue la de Ramiro, a las 15:45.\r\n\xC9l hab\xEDa
    descubierto algo que deb\xEDa\r\npermanecer oculto. Intent\xE9 convencerlo de
    que\r\nguardara silencio, pero no quiso escucharme.\r\n\r\nLa \xFAltima fue la
    de Marta, a las 22:55.\r\nElla sab\xEDa lo que hab\xEDa hecho. Me dijo que\r\nal
    d\xEDa siguiente acudir\xEDa a la polic\xEDa. Le supliqu\xE9\r\nque no lo hiciera,
    pero su mirada ya no era\r\nla de alguien que me conoc\xEDa. Era la de alguien\r\nque
    me tem\xEDa. Aquella noche comet\xED el peor\r\nde mis errores."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 79459efec17a4d00a321bdcc27bbc385, type: 2}
